{
    servers {
        # Cloudflare sits in front of Caddy. Without trusting its ranges, Caddy
        # discards the X-Forwarded-For Cloudflare sends and substitutes the
        # Cloudflare edge IP, so the backend's rate limiters key every voter
        # behind that edge into one shared bucket. With these trusted, Caddy
        # appends to Cloudflare's header and the backend (TRUST_PROXY_HOPS=3)
        # resolves the real client IP. Requests arriving from anywhere else
        # still have their X-Forwarded-For replaced, so it can't be spoofed by
        # hitting the origin directly.
        #
        # Source: https://www.cloudflare.com/ips/ (fetched 2026-10-27). The list
        # changes rarely, but re-check it before each election.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

avoinvaalikone.fi {
    # 8080: frontend nginx runs unprivileged (see vaalikone-frontend/Dockerfile)
    reverse_proxy frontend:8080

    # When the frontend can't be reached (deploy, restart), Caddy logs the
    # error at ERROR with the whole request URI: every request in flight
    # writes its party, registration or candidate token
    # (/api/candidates/me/<token>, /?candidateToken=<token>) to the caddy log
    # (issue #36). An error a handle_errors route answers is logged at DEBUG,
    # below the default INFO level. The client gets the same status; the cost
    # is that Caddy no longer logs why (the frontend's own log can't either,
    # since the request never reached it).
    handle_errors {
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
