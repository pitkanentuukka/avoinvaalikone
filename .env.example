# Server
PORT=3000
NODE_ENV=development
# Required in production: prevents Host header injection in HTTPS redirects
# PUBLIC_HOST=your-domain.example.com
# Number of reverse proxies in front of the app (Cloudflare → Caddy → nginx = 3).
# Must match the real chain or rate limiting keys on a proxy IP instead of the client.
# TRUST_PROXY_HOPS=1

# PostgreSQL
DATABASE_URL=postgres://vaalikone:vaalikone@localhost:5432/vaalikone
# Connections per backend process. With N replicas the DB sees N × PG_POOL_MAX;
# keep the product well under Postgres max_connections (100). Prod: 3 × 10.
# PG_POOL_MAX=10
# Kill queries running longer than this (ms) so a runaway query can't pin
# pool slots. Migrations are exempt (they use their own client).
# PG_STATEMENT_TIMEOUT_MS=10000
# Client-side query timeout (ms) for when the server can't answer at all
# (half-open connection). The connection is closed when it fires. Keep it
# above PG_STATEMENT_TIMEOUT_MS; the default is that plus 5000 (off when
# the statement timeout is 0).
# PG_QUERY_TIMEOUT_MS=15000

# Redis (shared rate-limit store across backend replicas).
# Leave unset to fall back to per-process in-memory rate limiting.
# REDIS_URL=redis://localhost:6379

# Voter match rate limit per IP per minute. Default 300 allows for carrier
# CGNAT (many voters behind one IP). Raise for k6 load tests in prod mode.
# RATE_LIMIT_MATCH_MAX=300

# Admin secret (used as Bearer token for admin endpoints)
ADMIN_SECRET=change-me-to-a-real-secret

# CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Nightly Postgres backups (production; see scripts/backup/). S3-compatible
# UpCloud Object Storage credentials — leave unset to keep dumps local-only.
# BACKUP_BUCKET=vaalikone-backups
# BACKUP_S3_ENDPOINT=https://xxxxx.upcloudobjects.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# Sentry error tracking (optional — SDKs are inert when the DSN is unset).
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Email notifications for new question set submissions (optional)
# Leave SMTP_HOST unset to disable email entirely
ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@vaalikone.fi
# SMTP_USER=
# SMTP_PASS=
# Concurrent SMTP connections in the shared pool (default 3); lower it if the
# provider throttles bulk sends
# SMTP_MAX_CONNECTIONS=3
