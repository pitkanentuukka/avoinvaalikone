# Server
PORT=3000
NODE_ENV=development
# Required in production: prevents Host header injection in HTTPS redirects
# PUBLIC_HOST=your-domain.example.com
# Number of reverse proxies in front of the app (Cloudflare → Caddy → nginx = 3).
# Must match the real chain or rate limiting keys on a proxy IP instead of the client.
# TRUST_PROXY_HOPS=1

# PostgreSQL
DATABASE_URL=postgres://vaalikone:vaalikone@localhost:5432/vaalikone
# Connections per backend process. With N replicas the DB sees N × PG_POOL_MAX;
# keep the product well under Postgres max_connections (100). Prod: 3 × 10.
# PG_POOL_MAX=10
# Kill queries running longer than this (ms) so a runaway query can't pin
# pool slots. Migrations are exempt (they use their own client).
# PG_STATEMENT_TIMEOUT_MS=10000
# Client-side query timeout (ms) for when the server can't answer at all
# (half-open connection). The connection is closed when it fires. Keep it
# above PG_STATEMENT_TIMEOUT_MS; the default is that plus 5000 (off when
# the statement timeout is 0).
# PG_QUERY_TIMEOUT_MS=15000

# Redis (shared rate-limit store across backend replicas).
# Leave unset to fall back to per-process in-memory rate limiting.
# REDIS_URL=redis://localhost:6379

# Voter match rate limit per IP per minute. Default 300 allows for carrier
# CGNAT (many voters behind one IP). Raise for k6 load tests in prod mode.
# Positive safe integer only; invalid values warn at startup and use 300.
# RATE_LIMIT_MATCH_MAX=300

# Public read rate limits per IP per minute, counting only reads that miss
# the micro-cache. Same parsing as RATE_LIMIT_MATCH_MAX.
# Candidate pages (/api/candidates/<id>): every miss counts; default 1200.
# Raise it along with RATE_LIMIT_MATCH_MAX for k6 load tests.
# RATE_LIMIT_CANDIDATE_READ_MAX=1200
# Candidate list and question sets: only failed reads (status >= 400)
# count; default 300.
# RATE_LIMIT_LIST_READ_MAX=300

# Admin secret (used as Bearer token for admin endpoints)
ADMIN_SECRET=change-me-to-a-real-secret

# CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Nightly Postgres backups (production; see scripts/backup/). S3-compatible
# UpCloud Object Storage credentials — leave unset to keep dumps local-only.
# Create the bucket by hand; the access key should belong to a user limited to
# listing that bucket and reading/writing/deleting its objects
# (docs/production-readiness.md, Backups).
# BACKUP_BUCKET=vaalikone-backups
# BACKUP_S3_ENDPOINT=https://xxxxx.upcloudobjects.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# Sentry error tracking (optional — SDKs are inert when the DSN is unset).
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Email: candidate links, party links and notifications.
# Compose (dev): leave SMTP_HOST and SMTP_PORT commented out; they default to
# the mailpit service (start it with --profile dev).
# Plain Node: SMTP_HOST unset disables email entirely; to capture mail in a
# local mailpit, set SMTP_HOST=localhost and SMTP_PORT=1025.
# Production: docker-compose.prod.yml requires SMTP_HOST and SMTP_FROM. Use a
# real provider (port 587 with STARTTLS, or 465 with implicit TLS; TLS is
# required for every host but the local dev ones), its SMTP_USER and
# SMTP_PASS, and an SMTP_FROM on your own domain with SPF/DKIM/DMARC set up;
# the example.com sender below is a placeholder. The backend warns at startup
# about dev values left in. See docs/production-readiness.md (Email).
ADMIN_EMAIL=admin@example.com
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Implicit TLS from the first byte: on for port 465 whatever this says. Set
# true (or 1/yes/on) only for a provider's implicit-TLS port other than 465.
# SMTP_SECURE=
SMTP_FROM=noreply@example.com
# SMTP_USER=
# SMTP_PASS=
# Concurrent SMTP connections in the shared pool (default 3); lower it if the
# provider throttles bulk sends
# SMTP_MAX_CONNECTIONS=3
